# Copy this file to .env and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=

# Alibaba Cloud Model Studio (Qwen) -- used for the independent second-opinion
# Skeptic and the Quant Checker agent. Full (non-dry-run) checks need this
# filled in alongside ANTHROPIC_API_KEY.
QWEN_API_KEY=

# Google AI (Gemini) -- used for Bull, Bear, and both digest steps (news +
# filings). Full (non-dry-run) checks need this filled in too.
GEMINI_API_KEY=

# Optional -- adds a second news source (Yahoo Finance news works with no key at all).
FINNHUB_API_KEY=

# Optional -- also unlocks Finnhub's insider sentiment (MSPR) and analyst
# recommendation trend, using the same key above, no separate signup needed.

# Optional -- Federal Reserve (FRED) economic data, completely free with no
# paid tier. Adds inflation, unemployment, fed funds rate, and yield curve
# to macro_context. Get a key at https://fredaccount.stlouisfed.org
FRED_API_KEY=

# Optional -- Financial Modeling Prep, free tier (250 calls/day). Adds a DCF
# fair-value estimate and PEG ratio, used by Bull/Bear/Judge's fair-value
# estimate alongside yfinance's own analyst targets.
FMP_API_KEY=

MONTHLY_SPEND_LIMIT_USD=50

# SEC EDGAR requires a descriptive User-Agent identifying who's making requests
# (used for insider transactions + filings digest). Format: "YourName your@email.com"
SEC_EDGAR_USER_AGENT=StockLLM yourname@example.com

# Optional overrides -- both have sensible defaults (output/ and storage/stockllm.db
# next to this file) for normal CLI use. The Home Assistant add-on sets these to
# paths under /data instead (see run.sh); no need to touch these for local CLI use.
# OUTPUT_DIR=output
# DB_PATH=storage/stockllm.db
