__pycache__/
*.pyc
.env
storage/*.db
.claude/settings.local.json

# webui/ is a Vite project (see webui/vite.config.js) -- built output goes
# to dashboard/assets/dist/, produced by `npm ci && npm run build` (or the
# Docker image's builder stage; see Dockerfile). Neither is checked in.
webui/node_modules/
dashboard/assets/dist/
# ensure_vendored_assets() also copies the built webui output next to any
# HTML the CLI writes into output/, so the same built-output exclusion
# applies there.
output/assets/
